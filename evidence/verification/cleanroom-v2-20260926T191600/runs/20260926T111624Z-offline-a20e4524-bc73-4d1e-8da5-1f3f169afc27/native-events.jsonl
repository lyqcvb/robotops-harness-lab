{"type":"request/header","seq":6,"time":1790421384432,"data":{"header":{"config":{"provider":"business-scripted","model":"scripted-business-v1","maxTokens":1024},"tools":[{"name":"create_maintenance_ticket","description":"Create an idempotent maintenance ticket for a robot that could not be recovered.","parameters":{"type":"object","properties":{"robot_id":{"type":"string"},"reason":{"type":"string"}},"required":["robot_id","reason"],"additionalProperties":false}},{"name":"force_reboot","description":"Submit a controlled reboot request for a robot in ERROR state. The host requires external one-time approval before any side effects. Without approval, the action will not execute.","parameters":{"type":"object","properties":{"robot_id":{"type":"string"}},"required":["robot_id"],"additionalProperties":false}},{"name":"get_robot_status","description":"Read the current robot state, battery, fault code, and bound task.","parameters":{"type":"object","properties":{"robot_id":{"type":"string"}},"required":["robot_id"],"additionalProperties":false}},{"name":"get_task_status","description":"Read the current task status and its bound robot.","parameters":{"type":"object","properties":{"task_id":{"type":"string"}},"required":["task_id"],"additionalProperties":false}},{"name":"restart_navigation","description":"Restart the navigation stack of a robot in ERROR state (recovery action, at most twice).","parameters":{"type":"object","properties":{"robot_id":{"type":"string"}},"required":["robot_id"],"additionalProperties":false}},{"name":"resume_task","description":"Resume a paused task after the robot has been verified healthy.","parameters":{"type":"object","properties":{"robot_id":{"type":"string"},"task_id":{"type":"string"}},"required":["robot_id","task_id"],"additionalProperties":false}},{"name":"search_sop","description":"Look up the recovery SOP for an error code. Never invent recovery steps.","parameters":{"type":"object","properties":{"error_code":{"type":"string"}},"required":["error_code"],"additionalProperties":false}}]},"reason":"initial"},"run_id":"20260926T111624Z-offline-a20e4524-bc73-4d1e-8da5-1f3f169afc27","session_id":"navigation_restart_success-20260926T111624Z-offline-a20e4524-bc73-4d1e-8da5-1f3f169afc27-7e2f1ad9-6b70-4e1e-8f9e-ce1dd4ad203e"}
